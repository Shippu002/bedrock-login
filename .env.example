# Copy this file to `.env` and replace each value with your Firebase web app config.
# You can find these in Firebase Console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Optional. Only add this if your Firebase web app includes Analytics.
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Backend API base URL from the Postman collection.
VITE_API_BASE_URL=https://api.bedrockresidences.com/api/v1

# Optional local debugging. Logs auth endpoints/statuses in dev while redacting passwords/tokens.
VITE_DEBUG_AUTH=false
